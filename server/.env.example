PORT=8787
NODE_ENV=production

# SQLite database file and uploaded files (absolute paths on the VPS)
DATABASE_PATH=/home/DEPLOY_USER/ezziyyani-cms/server/data/content.db
# Public uploads live in the static site folder so HTTPS can serve them without nginx /api proxy.
UPLOAD_DIR=/var/www/ezziyyani-portfolio-deploy/uploads
DIST_DIR=/var/www/ezziyyani-portfolio-deploy
HOST=0.0.0.0

# Single admin account. Generate the hash with: npm run hash-password -- "the-password"
ADMIN_EMAIL=mezzyani@uae.ac.ma
ADMIN_PASSWORD_HASH=

# Long random string (at least 32 characters)
JWT_SECRET=

# Avatar IA — add the key in server/.env (never in the frontend)
# OpenAI:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Groq example:
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
